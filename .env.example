# Copy to .env.local and fill in from your Supabase project settings.
# Without these the admin panel falls back to local-only editing, and
# uploaded images stay inline in the editor's own browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Then, in the Supabase dashboard:
#   1. SQL editor  -> run supabase/schema.sql (creates the content table and
#                     the public "media" bucket with their policies)
#   2. Authentication -> Users -> create the administrator account
#   3. Authentication -> Providers -> disable public sign-ups
#
# On Vercel, add the same two variables under Settings -> Environment
# Variables, then redeploy: Vite inlines them at build time.
